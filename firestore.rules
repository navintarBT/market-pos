rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    // ── Users ─────────────────────────────────────────────────────────────
    // Each user has { role, shopId? } — source of truth for permissions
    match /users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isControlAdmin());
      allow create: if isControlAdmin()
        || (
          isShopOwner(request.resource.data.shopId)
          && request.resource.data.role == 'staff'
          && request.resource.data.keys().hasAll(['role', 'shopId', 'email', 'displayName', 'createdAt'])
        )
        || (
          // Owner migrating their own account to a new uid (self email change)
          isShopOwner(request.resource.data.shopId)
          && request.resource.data.role == 'customer'
          && request.resource.data.keys().hasAll(['role', 'shopId', 'email', 'createdAt'])
        );
      allow update: if isControlAdmin()
        || (
          isShopOwner(resource.data.shopId)
          && resource.data.role == 'staff'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        )
        || (
          // Self-service: any user may set their own profile photo.
          request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profileUrl', 'updatedAt'])
        );
      allow delete: if isControlAdmin()
        || (
          isShopOwner(resource.data.shopId)
          && resource.data.role == 'staff'
        )
        || (
          // Owner deleting their own old doc after an email change
          uid == request.auth.uid
          && resource.data.role == 'customer'
        );
    }

    // ── Customers (personal info, control panel only) ─────────────────────
    match /customers/{customerId} {
      allow read:   if isControlAdmin();
      allow create: if isControlAdmin();
      allow update: if isControlAdmin();
      allow delete: if isControlAdmin();

      match /payments/{paymentId} {
        allow read:   if isControlAdmin();
        allow create: if isControlAdmin();
        allow update: if isControlAdmin();
        allow delete: if isControlAdmin();
      }
    }

    // ── Packages (Control Panel only) ────────────────────────────────────
    match /packages/{packageId} {
      allow read:   if isControlAdmin();
      allow create: if isControlAdmin();
      allow update: if isControlAdmin();
      allow delete: if isControlAdmin();
    }

    // ── Tenants (Control Panel) ───────────────────────────────────────────
    match /tenants/{tenantId} {
      allow read: if isControlAdmin() || isShopMember(tenantId);
      allow write: if isControlAdmin();

      match /invoices/{invoiceId} {
        allow read: if isControlAdmin();
        allow write: if isControlAdmin();
      }
    }

    // ── Shops ─────────────────────────────────────────────────────────────
    // Every write below (except pure control-admin actions) also requires
    // isTenantActive(shopId) — a shop that's suspended/cancelled/expired can
    // still be READ (so an owner can view/export their own history) but
    // can't keep recording sales, adding products, etc. Reads stay open on
    // purpose; only the "keep running the business" actions are gated.
    // This closes the gap where the app's own "blocked" screen was a
    // client-side-only check that anyone talking to Firestore directly
    // (bypassing the app) could ignore.
    match /shops/{shopId} {
      allow read: if isControlAdmin() || isShopMember(shopId);
      allow create, delete: if isControlAdmin();
      allow update: if isControlAdmin() || (
        isTenantActive(shopId)
        && isShopOwner(shopId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'profileUrl', 'updatedAt'])
        && request.resource.data.name is string
        && (
          !('profileUrl' in request.resource.data)
          || request.resource.data.profileUrl is string
        )
      );

      match /products/{productId} {
        allow read:   if isControlAdmin() || isShopMember(shopId);
        allow create: if isTenantActive(shopId) && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canManageProducts'));
        // Selling (recordSale) and cancelling/editing a sale (deleteSale,
        // removeItemFromSale) adjust product stock as part of their
        // transaction even though neither action is "managing products" —
        // any shop member may update ONLY `variants` (stock) for that;
        // changing name/price/cost/photo/category still needs
        // canManageProducts.
        allow update: if isTenantActive(shopId) && (
          isShopOwner(shopId)
          || hasStaffPermission(shopId, 'canManageProducts')
          || (isShopMember(shopId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['variants']))
        );
        allow delete: if isTenantActive(shopId) && isShopOwner(shopId);
      }

      match /sales/{saleId} {
        allow read:   if isControlAdmin() || isShopMember(shopId);
        allow create: if isTenantActive(shopId) && isShopMember(shopId) && validSale(request.resource.data);
        // Price edit / split-price / partial item removal (SalesHistory) only ever
        // touch `items` + `total` — mirrors the UI gate (canEditCartPrice for price
        // edits, canDeleteSales for item removal); everything else on a recorded
        // sale (paymentType, sellerUid, createdAt, ...) stays immutable.
        allow update: if (
            isControlAdmin()
            || (isTenantActive(shopId) && (
              isShopOwner(shopId)
              || (isShopMember(shopId) && (hasStaffPermission(shopId, 'canEditCartPrice') || hasStaffPermission(shopId, 'canDeleteSales')))
            ))
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'total'])
          && request.resource.data.total is number
          && request.resource.data.total >= 0;
        allow delete: if isControlAdmin()
          || (isTenantActive(shopId) && (
            isShopOwner(shopId)
            || (isShopMember(shopId) && hasStaffPermission(shopId, 'canDeleteSales'))
          ));
      }

      match /expenses/{expenseId} {
        allow read:   if isControlAdmin() || isShopMember(shopId);
        allow create: if isTenantActive(shopId)
          && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canAddExpenses'))
          && request.resource.data.keys().hasAll(['description', 'amount', 'createdAt'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
        allow update: if isTenantActive(shopId)
          && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canAddExpenses'))
          && request.resource.data.keys().hasAll(['description', 'amount'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
        allow delete: if isTenantActive(shopId) && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canAddExpenses'));
      }

      match /incomes/{incomeId} {
        allow read:   if isControlAdmin() || isShopMember(shopId);
        allow create: if isTenantActive(shopId)
          && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canAddExpenses'))
          && request.resource.data.keys().hasAll(['description', 'amount', 'paymentType', 'createdAt'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.paymentType in ['cash', 'transfer', 'cod'];
        allow update: if isTenantActive(shopId)
          && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canAddExpenses'))
          && request.resource.data.keys().hasAll(['description', 'amount', 'paymentType'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
        allow delete: if isTenantActive(shopId) && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canAddExpenses'));
      }

      match /categories/{categoryId} {
        allow read:   if isControlAdmin() || isShopMember(shopId);
        allow create: if isTenantActive(shopId)
          && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canManageProducts'))
          && request.resource.data.keys().hasAll(['name'])
          && request.resource.data.name is string;
        allow update: if isTenantActive(shopId)
          && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canManageProducts'))
          && request.resource.data.name is string;
        allow delete: if isTenantActive(shopId) && isShopOwner(shopId);
      }

      match /bundles/{bundleId} {
        allow read:           if isControlAdmin() || isShopMember(shopId);
        allow create, update: if isTenantActive(shopId) && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canManageProducts'));
        allow delete:         if isTenantActive(shopId) && isShopOwner(shopId);
      }

      match /returns/{returnId} {
        allow read:   if isControlAdmin() || isShopMember(shopId);
        allow create: if isTenantActive(shopId)
          && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canManageProducts'))
          && validReturn(request.resource.data);
        allow update: if false;
        allow delete: if isControlAdmin()
          || (isTenantActive(shopId) && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canManageProducts')));
      }

      match /users/{uid} {
        allow read:  if isControlAdmin() || isShopMember(shopId);
        allow write: if isControlAdmin() || (isTenantActive(shopId) && isShopOwner(shopId));
        // Self-service: any shop member may set their own profile photo on
        // their own nested record (the denormalized copy the staff list reads).
        // Not gated on tenant status — a harmless personal action, not "running
        // the business."
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profileUrl', 'updatedAt']);
      }

      match /transfers/{transferId} {
        allow read:   if isControlAdmin() || isShopMember(shopId);
        allow create: if isTenantActive(shopId) && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canManageProducts'));
        allow update: if false;
        allow delete: if isControlAdmin()
          || (isTenantActive(shopId) && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canManageProducts')));
      }
    }

    // ── Helpers ───────────────────────────────────────────────────────────

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return request.auth != null && getUserData().role == 'superadmin';
    }

    function isControlAdmin() {
      return request.auth != null
        && getUserData().role in ['superadmin', 'admin'];
    }

    function isShopMember(shopId) {
      let d = getUserData();
      return request.auth != null
        && (d.shopId == shopId || (d.keys().hasAny(['shopIds']) && d.shopIds.hasAny([shopId])))
        && d.role in ['customer', 'staff'];
    }

    function isShopOwner(shopId) {
      let d = getUserData();
      return request.auth != null
        && (d.shopId == shopId || (d.keys().hasAny(['shopIds']) && d.shopIds.hasAny([shopId])))
        && d.role == 'customer';
    }

    function hasStaffPermission(shopId, key) {
      return request.auth != null
        && exists(/databases/$(database)/documents/shops/$(shopId)/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/shops/$(shopId)/users/$(request.auth.uid)).data.permissions[key] == true;
    }

    // Mirrors parseTenant() in AuthContext.tsx: blocked if status is
    // suspended/cancelled, or if the relevant expiry timestamp
    // (trialEndsAt for trial, expiresAt otherwise) has passed. A tenant with
    // no expiry field at all (e.g. an unlimited plan) is never expired on
    // that basis. If the tenant doc is missing entirely, fail OPEN (treat as
    // active) — matches the client's own default in AuthContext.tsx, so a
    // shop that for some reason has no tenants/{shopId} doc doesn't get
    // silently locked out of every write.
    function isTenantActive(shopId) {
      let path = /databases/$(database)/documents/tenants/$(shopId);
      return !exists(path) || tenantNotExpired(get(path).data);
    }

    function tenantNotExpired(t) {
      let expiry = t.status == 'trial' && ('trialEndsAt' in t)
        ? t.trialEndsAt
        : (('expiresAt' in t) ? t.expiresAt : null);
      return t.status != 'suspended' && t.status != 'cancelled'
        && (expiry == null || expiry > request.time);
    }

    function validSale(data) {
      return data.keys().hasAll(['items', 'total', 'paymentType', 'createdAt'])
        && data.total is number
        && data.total > 0
        && (data.paymentType == 'cash' || data.paymentType == 'qr' || data.paymentType == 'cod');
    }

    function validReturn(data) {
      return data.keys().hasAll([
          'productId', 'productName', 'variantSize', 'variantColor',
          'quantity', 'costPrice', 'sellingPrice', 'createdAt'
        ])
        && data.quantity is int
        && data.quantity > 0
        && data.costPrice is number
        && data.costPrice >= 0
        && data.sellingPrice is number
        && data.sellingPrice >= 0
        && data.productId is string
        && data.productName is string;
    }
  }
}
